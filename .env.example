# ============================================================================
# ScrapSetu environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` in the repository root. The launcher does this
# automatically on first run. Never commit the real `.env`.
#
# Values below are safe DEVELOPMENT defaults. Before exposing the app to the
# internet, change SECRET_KEY, use PostgreSQL, turn off OTP_DEV_MODE and
# configure real SMS/email/storage providers (see docs/deployment.md).
# ============================================================================

# --- application -----------------------------------------------------------
# development | test | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=ScrapSetu
TIMEZONE=Asia/Kolkata
DEFAULT_CITY=Hyderabad
DEFAULT_CITY_SLUG=hyderabad
# Used in SMS/email links and CORS checks.
PUBLIC_WEB_URL=http://localhost:5173

# --- security --------------------------------------------------------------
# MUST be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=20
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=45
OTP_LENGTH=6
# true prints the OTP in API logs and returns `dev_otp` to the browser.
# MUST be false in production.
OTP_DEV_MODE=true
# Set true only when serving over HTTPS.
SECURE_COOKIES=false
# Comma-separated list (no spaces required).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- database --------------------------------------------------------------
# Zero-install local default:
DATABASE_URL=sqlite:///./scrapsetu.db
# Production (PostgreSQL 16, psycopg 3):
# DATABASE_URL=postgresql+psycopg://scrapsetu:change-me@localhost:5432/scrapsetu
DB_ECHO=false

# --- uploads / storage -----------------------------------------------------
# local | s3
STORAGE_BACKEND=local
STORAGE_DIR=./var/uploads
MAX_UPLOAD_MB=6
MAX_IMAGES_PER_REQUEST=8

# S3-compatible object storage (used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_SECONDS=900

# --- SMS / OTP delivery ----------------------------------------------------
# console | msg91 | twilio
# `console` logs the OTP and never sends an SMS. Development only.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- email -----------------------------------------------------------------
# console | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@scrapsetu.local
SMTP_USE_TLS=true

# --- maps (optional geocoding) --------------------------------------------
# none | google | mapbox
MAPS_PROVIDER=none
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- payments --------------------------------------------------------------
# ScrapSetu records cash/UPI payments and asks the customer to confirm them.
# No gateway is called and no payment is ever marked gateway-verified.
PAYMENT_GATEWAY=manual
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- operations ------------------------------------------------------------
ENABLE_SCHEDULER=true
OFFER_EXPIRY_SWEEP_SECONDS=60
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=120
# Only used by tooling; the launcher runs `python -m app.cli seed-demo`.
SEED_DEMO_ON_STARTUP=false
# Refuse demo seeding in production by setting this to false.
ALLOW_DEMO_SEED=true
